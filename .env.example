# Deployment environment. Copy to .env (git-ignored) and replace every placeholder.
# docker compose reads .env automatically; on other hosts set these as environment variables.
# Local development without Docker can instead use the git-ignored config/application.properties.

# --- Required ---
# Database password (also used by the compose db service as POSTGRES_PASSWORD).
SPRING_DATASOURCE_PASSWORD=change-me
# JWT signing key, Base64. Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-base64-from-openssl-rand

# --- Database (outside compose; compose builds the URL from POSTGRES_DB / POSTGRES_USER) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://db-host:5432/JobPortalDB
# SPRING_DATASOURCE_USERNAME=postgres
POSTGRES_DB=JobPortalDB
POSTGRES_USER=postgres

# --- Public URLs ---
# Where users open the site; used for links in emails. With the bundled SPA this is the app URL.
APP_BASE_URL=https://jobs.example.com
# Only if the frontend is hosted on a different origin than the API: comma-separated origins.
# Leave empty when the jar serves the SPA (the Docker image does).
APP_CORS_ALLOWED_ORIGINS=
# Host port compose publishes the app on.
APP_PORT=8080

# --- First admin ---
# Email of an already-registered account to promote to ADMIN at startup. Empty = no seeding.
APP_ADMIN_EMAIL=

# --- Email (SMTP). Empty username/password = no mail is sent; the app keeps running. ---
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=noreply@example.com

# --- Optional ---
# Gemini API key for the salary-estimate narrative. Unset = percentiles only.
GEMINI_API_KEY=
# Swagger UI and /v3/api-docs. Defaults to true in the app, false in docker-compose.
SWAGGER_ENABLED=false
# Log SQL statements. Default false.
SPRING_JPA_SHOW_SQL=false
# Where uploaded resumes/logos are stored. The image sets /app/uploads (a volume).
# APP_UPLOAD_DIR=/app/uploads
