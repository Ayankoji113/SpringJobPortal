# Local development needs no .env file: the API base falls back to http://localhost:8080/api.
# Copy to .env.local only to point somewhere else (for example a backend on another port).
#
# Vite inlines VITE_* at BUILD time, so set this before `npm run build`:
#   /api                         when the Spring Boot jar serves the SPA (what the Dockerfile does)
#   https://api.example.com/api  when the API is on a different origin (also add the SPA's
#                                origin to APP_CORS_ALLOWED_ORIGINS on the backend)
VITE_API_URL=http://localhost:8080/api
